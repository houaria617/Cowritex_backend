# =========================
# Search
# =========================
# Get your free API key from: app.tavily.com
TAVILY_API_KEY='your_tavily_api_key_here'

# =========================
# Database
# =========================
# Get your connection string from: supabase.com dashboard
DATABASE_URL='postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres'

# =========================
# LangSmith (optional but recommended for debugging)
# =========================
# Get your free API key from: smith.langchain.com
LANGSMITH_API_KEY='your_langsmith_api_key_here'
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=cowritex

# =========================
# App settings
# =========================
# Environment: development | production
APP_ENV=development

# Default LLM model to use across all agents
DEFAULT_MODEL=llama-3.3-70b-versatile