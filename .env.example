# Template for environment variables
# Copy to .env and fill in real values
# NEVER commit .env — only .env.example
# =========================
# LLM
# =========================
# Get your free API key from: console.groq.com
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama3-70b-8192

GOOGLE_API_KEY=your-google-api-key-here
GEMINI_MODEL=gemini-1.5-pro
#we may add another api keys 

# =========================
# Search
# =========================
# Get your free API key from: app.tavily.com
TAVILY_API_KEY='your_tavily_api_key_here'

# =========================
# Database
# =========================
# Get your connection string from: supabase.com dashboard
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here



# ── LangSmith tracing ────────────────────────────────────────
LANGCHAIN_API_KEY=your-langsmith-api-key-here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=cowritex-dev
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
# Optional — redact data in traces (useful for GDPR / sensitive projects)
# LANGCHAIN_HIDE_INPUTS=true
# LANGCHAIN_HIDE_OUTPUTS=true

# ── HuggingFace (literature agent LLM) ───────────────────────
HF_TOKEN=your-huggingface-token-here

# ── App ──────────────────────────────────────────────────────
LOG_LEVEL=INFO
# =========================
# App settings
# =========================
# Environment: development | production
APP_ENV=development

# Default LLM model to use across all agents
DEFAULT_MODEL=llama-3.3-70b-versatile